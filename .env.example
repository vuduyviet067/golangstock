# Local PostgreSQL development database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/gostock?sslmode=disable

# Application environment: development (default), dev, test, staging, production, prod.
# staging and production enforce the stricter JWT_SECRET and CORS rules below.
# APP_ENV=development

# JWT signing secret (HS256, at least 32 bytes).
# development/test: optional; a built-in development secret is used when unset.
# staging/production: required; no leading/trailing whitespace; never the development secret.
# These checks cannot prove the secret is random. Generate it with:
#   openssl rand -base64 48
# JWT_SECRET=

# Browser origins allowed to call the API with credentials (comma-separated).
# development/test default when unset: http://localhost:5173,http://localhost:3000
# staging/production: required; https only; no localhost, *.localhost, loopback
# (127.0.0.0/8, [::1]) or unspecified (0.0.0.0, [::]) hosts.
# All environments: no wildcards, paths, queries, fragments, or userinfo;
# one trailing "/" is accepted and removed. Invalid entries stop startup.
# CORS_ALLOWED_ORIGINS=https://app.example.com
